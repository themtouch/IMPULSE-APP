# Impulse — variables de entorno (copiar a .env.local y rellenar). NUNCA commitear .env*.

# --- Supabase (backend) ---
# URL del proyecto Supabase (pública)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave anónima (pública por diseño; se usa en el cliente vía env, con RLS activo)
SUPABASE_ANON_KEY=tu-anon-key
# Clave service_role: SOLO en servidor/Edge Functions. JAMÁS en el cliente ni en el bundle.
SUPABASE_SERVICE_ROLE_KEY=solo-en-servidor-nunca-en-cliente

# --- Pagos / suscripciones (entitlements en servidor, no en el cliente) ---
# Stripe
STRIPE_SECRET_KEY=sk_live_o_test_solo_servidor
STRIPE_WEBHOOK_SECRET=whsec_para_validar_webhooks
# RevenueCat (si se usa para móvil)
REVENUECAT_WEBHOOK_SECRET=secreto_webhook_revenuecat

# --- Media (catálogo de ejercicios) ---
# Base para GIF/imágenes de ejercicios. Cambiar a CDN propio o self-host para producción.
EXERCISE_MEDIA_BASE=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/
